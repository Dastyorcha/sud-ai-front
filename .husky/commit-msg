subject_line=$(head -n 1 "$1")

# Required format: "type: message"  (type, colon, space, then the message).
# Rejects reversed/other combinations like "message type:" or "[type] message".
pattern='^(feat|fix|docs|refactor|test|style|chore|task): .+'

if ! printf '%s' "$subject_line" | grep -qE "$pattern"; then
  cat <<EOF >&2

❌ Invalid commit message:
   "$subject_line"

Required format:
  type: description of changes

Allowed types:
  feat, fix, docs, refactor, test, style, chore, task

Correct:   feat: add tools data table
Incorrect: add tools data table feat:
Incorrect: [feat] add tools data table

EOF
  exit 1
fi
